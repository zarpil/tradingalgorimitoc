# Configuración del Bot Bybit
# Modo de ejecución: "demo" (Testnet) o "real" (Mainnet)
MODE=demo

# Credenciales Bybit TESTNET (Demo)
# Obtén tus API keys gratuitas en https://testnet.bybit.com
BYBIT_TESTNET_API_KEY=tu_api_key_testnet_aqui
BYBIT_TESTNET_API_SECRET=tu_api_secret_testnet_aqui

# Credenciales Bybit REAL (Mainnet)
# Solo se usarán cuando MODE=real
BYBIT_REAL_API_KEY=tu_api_key_real_aqui
BYBIT_REAL_API_SECRET=tu_api_secret_real_aqui

# Notificaciones opcionales de Telegram (dejar vacío si no se usan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Parámetros de Operativa
CAPITAL_TOTAL_EUR=100.0
LEVERAGE=1
MAX_SL_PCT=0.010
TP_RR_RATIO=2.5
